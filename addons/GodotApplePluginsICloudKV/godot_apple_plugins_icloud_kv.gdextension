[libraries]
ios = "res://addons/GodotApplePluginsICloudKV/bin/GodotApplePluginsICloudKV.xcframework"
macos.arm64 = "res://addons/GodotApplePluginsICloudKV/bin/GodotApplePluginsICloudKV.framework"

[dependencies]
ios = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.xcframework": "" }
macos.arm64 = { "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.framework": "" }
